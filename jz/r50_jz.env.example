# R50 -- Jean Zay site configuration (the ONLY file with site-specific values).
#
#   cp jz/r50_jz.env.example jz/r50_jz.env      # jz/r50_jz.env is git-ignored, never commit it
#   then replace every <...> below.
#
# Sourced (bash) by every jz/r50_*.sh script, on this cluster and on Jean Zay; jz/r50_push.sh copies the
# filled file to Jean Zay next to the bundle. The scripts refuse to run while a value still contains '<'.
# Every job, including the short CPU-only r49_field, runs on the H100 partition
# (-C h100, 1 GPU, 24 CPUs): the project has GPU hours only.

# --- transfer: this cluster -> Jean Zay ----------------------------------------------------------------
JZ_HOST="<login>@jean-zay.idris.fr"     # rsync/ssh target; better: your ~/.ssh/config alias (e.g. "zay"), so its IdentityFile is
                                        # used -- the plain hostname does not match `Host zay` and falls back to a password
JZ_WORK="<absolute WORK path>"          # what `echo $WORK` prints on the Jean Zay frontal
JZ_REPO="${JZ_WORK}/StreamEdit_new"     # where the repo is cloned on Jean Zay

# --- Slurm accounting on Jean Zay ----------------------------------------------------------------------
JZ_ACCOUNT_GPU=""                       # empty = no -A line: IDRIS needs -A <project>@h100 only for multi-project
                                        # logins or projects with both CPU and GPU hours (exec_batch page)
JZ_QOS_GPU="qos_gpu_h100-t3"            # 20 h limit; qos_gpu_h100-dev for <= 2 h tests
JZ_CPUS_PER_GPU=24                      # gpu_p6 nodes = 4 H100 + 96 cores; memory follows the CPU count (preflight prints what Slurm gives)

# --- Python: IDRIS H100 module (loaded after `module load arch/h100`) -----------------------------------
# Only Wan-Edit runs on Jean Zay, and every Wan-side job uses our five-bench env (StreamEdit stays on the lab cluster).
JZ_MODULE="pytorch-gpu/py3/2.5.1"       # torch 2.5.1, as our five-bench env

# --- staging on this cluster ----------------------------------------------------------------------------
LOCAL_STAGE="${HOME}/Data/r50_stage"    # folder of symlinks to our files (no copy), sent by rsync --copy-unsafe-links
